# Copia questo file come server/.env.commesse (NON committarlo).
# Il service role key deve esistere solo sul PC/server che esegue il sincronizzatore.
SUPABASE_URL=https://TUO-PROGETTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=INSERISCI_SERVICE_ROLE_KEY

# Cartella che contiene direttamente TUTTE le cartelle delle commesse aperte.
# Esempio percorso UNC Windows:
COMMESSE_ROOT_PATH=\\SERVER\Documentazione impianti\Commesse\00-Commesse aperte 2026

# Ogni quanti minuti rifare automaticamente la scansione completa.
COMMESSE_SCAN_INTERVAL_MINUTES=15

# Ogni quanti secondi controllare se un admin ha premuto "Scansiona ora".
COMMESSE_REQUEST_POLL_SECONDS=10

# Profondita massima di ricerca file dentro ogni sottocartella standard.
COMMESSE_SCAN_MAX_DEPTH=12
